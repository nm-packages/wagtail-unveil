DJANGO_SETTINGS_MODULE=sandbox.settings
PYTHONPATH=.

# API key for the wagtail_unveil JSON endpoints (Bearer token auth).
# Set any non-empty string here to enable the API locally, then pass it as:
#   Authorization: Bearer <value>
# Absent or empty → API returns 500; wrong value → 403.
WAGTAIL_UNVEIL_API_KEY=dev-secret

# Limit how many pages per page type appear in frontend URL discovery.
# 0 = no limit, positive int = limit per type, absent/invalid = 1 (default).
# WAGTAIL_UNVEIL_PAGES_PER_TYPE=1

# Comma-separated URL path prefixes to exclude from discovery.
# Leading slashes are stripped. Absent or empty = no exclusions.
# Used as a startswith filter against each URL's full path.
# Admin routes include the admin/ prefix (e.g. admin/api/main/pages/).
# The example below hides frontend URLs starting with sample and
# admin URLs starting with admin/choose
# WAGTAIL_UNVEIL_SKIP_URL_PREFIXES=sample,admin/choose
