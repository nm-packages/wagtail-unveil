{
  "name": "wagtail-unveil",
  "private": true,
  "scripts": {
    "lint:assets": "biome check assets_src scripts tests/js",
    "lint:assets:fix": "biome check --write assets_src scripts tests/js",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "build:assets": "node scripts/build-report-assets.mjs",
    "build:assets:watch": "node scripts/build-report-assets.mjs --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "vitest": "^3.2.4"
  }
}
