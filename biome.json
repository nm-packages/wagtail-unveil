{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "include": [
      "assets_src/**/*.js",
      "assets_src/**/*.mjs",
      "assets_src/**/*.cjs",
      "scripts/**/*.js",
      "scripts/**/*.mjs",
      "scripts/**/*.cjs",
      "tests/js/**/*.js",
      "tests/js/**/*.mjs",
      "tests/js/**/*.cjs"
    ],
    "ignore": [
      "wagtail_unveil/static/wagtail_unveil/js/report.bundle.js",
      "wagtail_unveil/static/wagtail_unveil/js/report.bundle.min.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noInnerDeclarations": "off"
      },
      "performance": {
        "noDelete": "off"
      },
      "security": {
        "noGlobalEval": "off"
      },
      "suspicious": {
        "noShadowRestrictedNames": "off"
      },
      "style": {
        "noVar": "off",
        "useTemplate": "off"
      }
    }
  }
}
